# 服务配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=outdoor_ad_system
DB_USER=root
DB_PASSWORD=

# JWT配置（生产环境请替换为强随机密钥，至少64位）
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS 配置（生产环境填写实际域名，逗号分隔）
CORS_ORIGINS=https://yourdomain.com

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800
