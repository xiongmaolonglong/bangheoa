<view class="page-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar">
      <text class="avatar-text">{{userInfo.real_name ? userInfo.real_name[0] : '用'}}</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.real_name || '用户'}}</text>
      <text class="user-phone">{{userInfo.phone || '未绑定手机'}}</text>
    </view>
  </view>

  <!-- 订单统计 -->
  <view class="stats-card">
    <view class="stats-item" bindtap="goToOrders" data-status="pending_review">
      <text class="stats-num">{{stats.pending || 0}}</text>
      <text class="stats-label">待审核</text>
    </view>
    <view class="stats-item" bindtap="goToOrders" data-status="measuring">
      <text class="stats-num">{{stats.measuring || 0}}</text>
      <text class="stats-label">测量中</text>
    </view>
    <view class="stats-item" bindtap="goToOrders" data-status="producing">
      <text class="stats-num">{{stats.producing || 0}}</text>
      <text class="stats-label">生产中</text>
    </view>
    <view class="stats-item" bindtap="goToOrders" data-status="archived">
      <text class="stats-num">{{stats.archived || 0}}</text>
      <text class="stats-label">已完成</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goToOrders">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToMap">
      <text class="menu-icon">📍</text>
      <text class="menu-text">地图查看</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToNotifications">
      <text class="menu-icon">🔔</text>
      <text class="menu-text">消息通知</text>
      <text class="menu-arrow">></text>
      <text class="menu-badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="changePassword">
      <text class="menu-icon">🔒</text>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="aboutUs">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn">
    <button class="btn-plain btn-block" bindtap="logout">退出登录</button>
  </view>
</view>