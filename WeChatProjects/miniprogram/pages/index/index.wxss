/* 自适应布局，适配各种屏幕尺寸 */
.page-container {
  min-height: 100vh;
  height: 100vh;
  background: linear-gradient(180deg, #409EFF 0%, #66B1FF 50%, #A0CFFF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.logo-section {
  margin-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.logo-icon {
  font-size: 72rpx;
}

.logo-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
  text-align: center;
}

.logo-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  text-align: center;
}

.apply-btn {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: none;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  flex-shrink: 0;
}

.apply-btn::after {
  border: none;
}

.apply-btn:active {
  transform: scale(0.95);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);
}

.apply-icon {
  font-size: 80rpx;
  color: #409EFF;
  line-height: 1;
  font-weight: 300;
}

.apply-text {
  font-size: 30rpx;
  color: #409EFF;
  font-weight: 600;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

.tip {
  margin-top: 50rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
  text-align: center;
}

/* 小屏幕适配 */
@media (max-height: 600px) {
  .logo-section {
    margin-bottom: 40rpx;
  }

  .logo-circle {
    width: 120rpx;
    height: 120rpx;
    margin-bottom: 16rpx;
  }

  .logo-icon {
    font-size: 56rpx;
  }

  .logo-title {
    font-size: 44rpx;
  }

  .logo-subtitle {
    font-size: 22rpx;
  }

  .apply-btn {
    width: 180rpx;
    height: 180rpx;
  }

  .apply-icon {
    font-size: 60rpx;
  }

  .apply-text {
    font-size: 24rpx;
  }

  .tip {
    margin-top: 30rpx;
    font-size: 22rpx;
  }
}

/* 平板适配 */
@media (min-width: 750rpx) {
  .logo-circle {
    width: 200rpx;
    height: 200rpx;
  }

  .logo-icon {
    font-size: 88rpx;
  }

  .logo-title {
    font-size: 72rpx;
  }

  .logo-subtitle {
    font-size: 32rpx;
  }

  .apply-btn {
    width: 300rpx;
    height: 300rpx;
  }

  .apply-icon {
    font-size: 100rpx;
  }

  .apply-text {
    font-size: 38rpx;
  }

  .tip {
    font-size: 30rpx;
  }
}

/* 横屏适配 */
@media (orientation: landscape) and (max-height: 500px) {
  .content {
    flex-direction: row;
    justify-content: space-around;
    padding: 20rpx 80rpx;
  }

  .logo-section {
    margin-bottom: 0;
  }

  .apply-btn {
    margin-top: 0;
  }

  .tip {
    position: absolute;
    bottom: 20rpx;
  }
}