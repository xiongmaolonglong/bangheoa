<view class="page-container">
  <view class="content">
    <!-- Logo -->
    <view class="logo-section">
      <view class="logo-circle">
        <image class="logo-img" src="/images/logo.png" mode="aspectFit" />
      </view>
      <text class="logo-title">广告测量申请</text>
      <text class="logo-subtitle">邦和广告一站式服务平台</text>
    </view>

    <!-- 申请按钮 -->
    <button class="apply-btn" bindtap="goToCreate">
      <text class="apply-icon">+</text>
      <text class="apply-text">申请测量</text>
    </button>

    <!-- 提示 -->
    <text class="tip">点击按钮提交测量申请</text>
  </view>
</view>