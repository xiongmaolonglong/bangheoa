.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.header {
  background: #67c23a;
  padding: 40rpx 30rpx 60rpx;
}

.greeting {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.date {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  margin-top: 8rpx;
  display: block;
}

.stats-row {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-top: -30rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #303133;
  display: block;
}

.stat-card.active .stat-value {
  color: #67c23a;
}

.stat-label {
  font-size: 24rpx;
  color: #909399;
  margin-top: 6rpx;
  display: block;
}

.cta-card {
  margin: 30rpx;
  background: linear-gradient(135deg, #67c23a, #85ce61);
  border-radius: 16rpx;
  padding: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(103, 194, 58, 0.3);
}

.cta-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 16rpx;
}

.cta-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
}

.section-more {
  font-size: 24rpx;
  color: #909399;
}

.recent-list {
  padding: 0 30rpx;
}

.recent-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recent-info {
  display: flex;
  flex-direction: column;
}

.recent-no {
  font-size: 26rpx;
  font-weight: 500;
  color: #303133;
}

.recent-title {
  font-size: 24rpx;
  color: #606266;
  margin-top: 6rpx;
}

.recent-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.recent-stage {
  font-size: 24rpx;
  font-weight: 500;
}

.recent-date {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 4rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  color: #c0c4cc;
  font-size: 26rpx;
}
