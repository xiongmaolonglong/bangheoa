<view class="container">
  <!-- Header -->
  <view class="header">
    <text class="greeting">你好，{{userInfo.name}}</text>
    <text class="date">{{today}}</text>
  </view>

  <!-- Stats -->
  <view class="stats-row">
    <view class="stat-card" bindtap="goToDeclareList">
      <text class="stat-value">{{totalCount}}</text>
      <text class="stat-label">我的申报</text>
    </view>
    <view class="stat-card active">
      <text class="stat-value">{{activeCount}}</text>
      <text class="stat-label">进行中</text>
    </view>
  </view>

  <!-- Primary CTA -->
  <view class="cta-card" bindtap="goToDeclare">
    <text class="cta-icon">+</text>
    <text class="cta-text">新建申报</text>
  </view>

  <!-- Recent Declarations -->
  <view class="section-header">
    <text class="section-title">最近申报</text>
    <text class="section-more" bindtap="goToDeclareList">全部 ></text>
  </view>

  <view class="recent-list">
    <view class="recent-item" wx:for="{{recentList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="recent-info">
        <text class="recent-no">{{item.declareNo}}</text>
        <text class="recent-title">{{item.title}}</text>
      </view>
      <view class="recent-meta">
        <text class="recent-stage" style="color: {{item.stageColor}}">{{item.stage}}</text>
        <text class="recent-date">{{item.createdAt}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{recentList.length === 0}}">
      <text class="empty-text">暂无申报记录</text>
    </view>
  </view>
</view>
