<view class="container">
  <!-- User Card -->
  <view class="user-card">
    <view class="avatar">{{userInfo.name ? userInfo.name[0] : '?'}}</view>
    <view class="user-info">
      <text class="user-name">{{userInfo.name}}</text>
      <text class="user-phone">{{userInfo.phone}}</text>
      <text class="user-dept">{{userInfo.department}}</text>
    </view>
  </view>

  <!-- Menu -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onNotification">
      <text class="menu-icon">🔔</text>
      <text class="menu-text">通知设置</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item logout" bindtap="onLogout">
      <text class="menu-text">退出登录</text>
    </view>
  </view>

  <view class="version">v1.0.0</view>
</view>
