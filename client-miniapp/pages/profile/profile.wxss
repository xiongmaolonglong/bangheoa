.container {
  min-height: 100vh;
  background: #f5f7fa;
}

.user-card {
  background: linear-gradient(135deg, #67c23a, #85ce61);
  padding: 50rpx 30rpx 40rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
}

.user-phone {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.user-dept {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.menu-list {
  background: #fff;
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #303133;
}

.menu-arrow {
  font-size: 26rpx;
  color: #c0c4cc;
}

.menu-item.logout {
  justify-content: center;
}

.menu-item.logout .menu-text {
  text-align: center;
  color: #f56c6c;
}

.version {
  text-align: center;
  color: #c0c4cc;
  font-size: 22rpx;
  margin-top: 40rpx;
}
