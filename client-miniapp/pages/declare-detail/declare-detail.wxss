.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.header-card {
  background: linear-gradient(135deg, #67c23a, #85ce61);
  padding: 40rpx 30rpx;
}

.declare-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
}

.declare-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-top: 8rpx;
}

.declare-stage {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
  display: block;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 20rpx;
  display: block;
}

/* Timeline */
.timeline {
  padding-left: 20rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 28rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #dcdfe6;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.timeline-item.done .timeline-dot {
  background: #67c23a;
  border-color: #67c23a;
}

.timeline-item.current .timeline-dot {
  border-color: #67c23a;
  box-shadow: 0 0 0 4rpx rgba(103, 194, 58, 0.2);
}

.timeline-check {
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
}

.timeline-line {
  position: absolute;
  left: 34rpx;
  top: 36rpx;
  width: 3rpx;
  height: calc(100% - 8rpx);
  background: #ebeef5;
}

.timeline-item.done .timeline-line {
  background: #67c23a;
}

.timeline-label {
  font-size: 26rpx;
  color: #c0c4cc;
  margin-left: 16rpx;
  margin-top: 4rpx;
}

.timeline-label.active {
  color: #303133;
  font-weight: 500;
}

/* Info rows */
.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #909399;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #303133;
  flex: 1;
}

/* Photos */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

/* Log */
.log-list {
  padding-left: 20rpx;
}

.log-item {
  display: flex;
  position: relative;
  padding-bottom: 28rpx;
}

.log-item:last-child {
  padding-bottom: 0;
}

.log-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #67c23a;
  flex-shrink: 0;
  margin-top: 6rpx;
  position: relative;
  z-index: 1;
}

.log-line {
  position: absolute;
  left: 26rpx;
  top: 26rpx;
  width: 3rpx;
  height: calc(100% - 26rpx);
  background: #ebeef5;
}

.log-content {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.log-text {
  font-size: 26rpx;
  color: #303133;
}

.log-time {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 4rpx;
}
