.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: linear-gradient(135deg, #67c23a 0%, #85ce61 100%);
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.logo-text {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}

.title {
  color: #fff;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.subtitle {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

.login-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80%;
}

.wechat-btn {
  width: 100%;
  background: #fff;
  color: #07c160;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.wechat-btn::after {
  border: none;
}

.wechat-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.tip {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.tip-error {
  margin-top: 16rpx;
  color: #ffe0e0;
  font-size: 24rpx;
}
